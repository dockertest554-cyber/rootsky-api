# Server config
PORT=5000
CLIENT_ORIGIN=https://www.rootskysystem.com

# Where website enquiries are delivered (comma-separate for several inboxes)
MAIL_TO=sales@rootskysystem.com

# Option A (recommended, works on Render's free plan): Resend HTTPS API
# Sign up at resend.com, verify rootskysystem.com, create an API key.
RESEND_API_KEY=
MAIL_FROM=Rootsky Website <noreply@rootskysystem.com>

# Option B: SMTP (used only when RESEND_API_KEY is empty; needs a paid Render plan)
# e.g. Google Workspace: smtp.gmail.com / 465 / your address / an App Password
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
